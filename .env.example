# Payload
PAYLOAD_SECRET=

# Postgres (Neon)
DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/mis_recetas?sslmode=require

# S3 / Cloudflare R2
S3_BUCKET=mis-recetas-media
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_HOSTNAME=pub-xxxx.r2.dev

# Next
# Se consume en el build, no en runtime: NEXT_PUBLIC_* se incrusta al
# compilar y las páginas de receta se prerenderizan ahí. En producción debe
# valer el dominio real antes de `npm run build` (Docker la recibe como
# build-arg). Definirla solo en el contenedor deja og:image y canonical
# apuntando a localhost.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
